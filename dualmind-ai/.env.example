# Set at least one provider key. Never put keys in public/ or commit them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Production requires an APP_PASSWORD of at least 20 characters.
APP_PASSWORD=replace-with-a-long-random-password
PORT=3000
# Optional model overrides, see provider's current API model access
OPENAI_MODEL=gpt-6.1-sol
OPENAI_SMALL_MODEL=gpt-6-luna
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-5-5
ANTHROPIC_LARGE_MODEL=claude-opus-5-5
# Optional upstream URLs, intended only for integration testing
# OPENAI_API_URL=https://api.openai.com/v1/responses
# ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
